{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main",
    "popover"
  ],
  "permissions": [
    "core:default",
    "global-shortcut:default",
    "autostart:default",
    "notification:default",
    "store:default",
    "positioner:default",
    "process:default",
    "shell:default",
    "dialog:default",
    "updater:default"
  ]
}
